#!/bin/sh
LOG_FILE="$(dirname "$0")/pre-commit.log"
STATUS_FILE="$(dirname "$0")/pre-commit.status"

echo "$(date): Running dotnet format..." > "$LOG_FILE"
echo "running" > "$STATUS_FILE"

dotnet format PepeProject.sln --verbosity detailed --include 2>&1 >> "$LOG_FILE"
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo "$(date): dotnet format failed with code $EXIT_CODE" >> "$LOG_FILE"
    rm -f "$STATUS_FILE"
    exit 1
fi

git add -u 2>&1 >> "$LOG_FILE"
echo "$(date): Formatting completed successfully" >> "$LOG_FILE"
rm -f "$STATUS_FILE"