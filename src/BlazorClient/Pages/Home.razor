            </div>
        </div>
        <div class="row">
            <div class="col-md-3 col-6 text-center mb-4">
                <div class="category-card p-3 rounded-3 bg-light">
                    <i class="fas fa-cat fa-2x text-purple mb-2"></i>
                    <h6>Котики</h6>
                </div>
            </div>
            <div class="col-md-3 col-6 text-center mb-4">
                <div class="category-card p-3 rounded-3 bg-light">
                    <i class="fas fa-gamepad fa-2x text-purple mb-2"></i>
                    <h6>Игры</h6>
                </div>
            </div>
            <div class="col-md-3 col-6 text-center mb-4">
                <div class="category-card p-3 rounded-3 bg-light">
                    <i class="fas fa-film fa-2x text-purple mb-2"></i>
                    <h6>Кино</h6>
                </div>
            </div>
            <div class="col-md-3 col-6 text-center mb-4">
                <div class="category-card p-3 rounded-3 bg-light">
                    <i class="fas fa-globe fa-2x text-purple mb-2"></i>
                    <h6>Политика</h6>
                </div>
            </div>
        </div>
    </div>
</section>